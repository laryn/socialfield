<?php
/**
 * @file
 * Field schema, install and uninstall functions for the social_field module.
 */

/**
 * Implements hook_field_schema().
 */
function socialfield_field_schema($field) {
  return array(
    'columns' => array(
      'service' => array(
        'type' => 'varchar',
        'length' => 32,
      ),
      'url' => array(
        'type' => 'varchar',
        'length' => 255,
      ),
      'weight' => array(
        'type' => 'int',
        'size' => 'small',
      ),
    ),
  );
}

/**
 * Moves Socialfield settings from variable to config.
 */
function socialfield_update_1000() {
  $services = variable_get('socialfield.settings', 'services');
  $config = config('socialfield.settings');
  $config->set('services', $services);
  $config->save();

  variable_del('socialfield_services');
}

/**
 * Update socialfield settings.
 */
function socialfield_update_1001() {
  $config = config('socialfield.settings');
  $services = $config->get('services');
  $default_services = socialfield_default_services();

  foreach ($services as $service_name => $service_info) {
    // Mark the service as enabled.
    $services[$service_name]['enabled'] = TRUE;
    // Add a service name key.
    $services[$service_name]['service_name'] = $service_name;
    // Change the 'name' key to 'label'.
    if (isset($services[$service_name]['name'])) {
      $services[$service_name]['label'] = $services[$service_name]['name'];
      unset($services[$service_name]['name']);
    }
    // Change the 'icon' key to 'icon_css'
    if (isset($services[$service_name]['icon'])) {
      $services[$service_name]['icon_css'] = $services[$service_name]['icon'];
      unset($services[$service_name]['icon']);
    }
    // Add the icon API info.
    if (isset($default_services[$service_name])) {
      $services[$service_name]['iconapi'] = $default_services[$service_name]['iconapi'];
      $services[$service_name]['iconapi_fill'] = $default_services[$service_name]['iconapi_fill'];
      // Remove the default service if it had been overridden.
      unset($default_services[$service_name]);
    }
  }

  // Add the other default services as disabled.
  foreach ($default_services as $service_name => $service_info) {
    $services[$service_name] = $default_services[$service_name];
    $services[$service_name]['enabled'] = FALSE;
  }

  $config->set('services', $services);
  $config->save();
}

