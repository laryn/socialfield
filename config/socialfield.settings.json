{
    "_config_name": "socialfield.settings",
    "_module": "socialfield",
    "services": {
        "linkedin": {
            "name": "LinkedIn",
            "icon": "linkedin-logo",
            "validation_pattern": "*linkedin.com/*"
        },
        "youtube": {
            "name": "YouTube",
            "icon": "youtube-logo",
            "validation_pattern": "*youtube.com/*"
        },
        "vimeo": {
            "name": "Vimeo",
            "icon": "video",
            "validation_pattern": "*vimeo.com/*"
        },
        "flickr": {
            "name": "Flickr",
            "icon": "camera",
            "validation_pattern": "*flickr.com/*"
        },
        "pinterest": {
            "name": "Pinterest",
            "icon": "pinterest-logo",
            "validation_pattern": "*pinterest.com/*"
        },
        "facebook": {
            "name": "Facebook",
            "icon": "facebook-logo",
            "validation_pattern": "*facebook.com/*"
        },
        "twitter": {
            "name": "Twitter",
            "icon": "twitter-logo",
            "validation_pattern": "*twitter.com/*"
        },
        "instagram": {
            "name": "Instagram",
            "icon": "instagram-logo",
            "validation_pattern": "*instagram.com/*"
        }
    }
}
